#----------------------------------------------------------------------
# iDerm4U — environment template
#
# Copy to .env and fill in real values. .env is git-ignored and is mounted
# into the container at /application/.env. It must NEVER be committed or
# baked into an image layer.
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# ENVIRONMENT
#----------------------------------------------------------------------

# MUST be "production" in the deployed environment. "development" turns on
# error_reporting(-1), display_errors=1, CI_DEBUG and DBDebug, which exposes
# SQL queries, bound parameters and stack traces to visitors.
CI_ENVIRONMENT = production

#----------------------------------------------------------------------
# JWT
#----------------------------------------------------------------------

# ROTATE THIS. It was exposed via a web-readable .env. With this key anyone
# can forge a token with any role, including admin (rle=1011).
jwt.secretkey = CHANGE_ME

# Token lifetime in MINUTES (see app/Libraries/JWTCI4.php).
jwt.ttl = 1440

#----------------------------------------------------------------------
# ENCRYPTION
#----------------------------------------------------------------------

# DO NOT ROTATE without a migration plan.
# This key decrypts faskes_server_key (Midtrans server key) and
# faskes_client_key values stored IN THE DATABASE. Rotating it makes every
# clinic's Midtrans key undecryptable and permanently breaks payments.
encrypt_key = UNCHANGED_FROM_CURRENT_PRODUCTION_VALUE

#----------------------------------------------------------------------
# MIDTRANS
#----------------------------------------------------------------------

MidtransisProduction = false

#----------------------------------------------------------------------
# RECAPTCHA v3
#----------------------------------------------------------------------

recaptchaKey    = CHANGE_ME
recaptchaSecret = CHANGE_ME

# REQUIRED. Without this, getenv() returns false and the check
# "$score >= $threshold" evaluates as "0.0 >= 0" -> always true, which
# disables the reCAPTCHA score gate entirely. Use 0.5 for production.
recaptchaThreshold = 0.5

#----------------------------------------------------------------------
# APP
#----------------------------------------------------------------------

app.baseURL = 'https://example.com/'

#----------------------------------------------------------------------
# DATABASE
#----------------------------------------------------------------------

database.default.hostname = iDerm4U-Database
database.default.database = iderm4u
database.default.username = iderm4u
database.default.password = CHANGE_ME
database.default.DBDriver  = Postgre
database.default.DBPrefix  =
database.default.port      = 5432

#----------------------------------------------------------------------
# SECURITY
#----------------------------------------------------------------------

# CSRF is ENABLED in app/Config/Filters.php. Every form emits csrf_field()
# and the AJAX handlers submit via FormData, so the token is sent.
security.tokenName  = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires    = 7200

# MUST be false. This app is AJAX-heavy: every form posts the token that
# was rendered at page load. With regenerate=true, CodeIgniter rotates the
# CSRF cookie after the first successful POST, so the SECOND post on the
# same page sends a stale token and fails.
# Since CI4 v4.5 an AJAX CSRF failure throws a SecurityException instead of
# redirecting, so it surfaces as a broken request, not a friendly error.
security.regenerate = false

# security.redirect = true
# security.samesite = 'Lax'